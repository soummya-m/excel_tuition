<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/header1') %>
  <title>Update Tutor</title>
  <style>
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 30px;
    }
    th, td {
      border: 1px solid #999;
      padding: 12px;
      text-align: center;
    }
    th {
      background-color: #3e6677;
      color: white;
    }
    tr:nth-child(even) {
      background-color: #f2f2f2;
    }
    h2 {
      text-align: center;
      margin-top: 40px;
    }
    /* Hide the ID column */
    th.id-column, td.id-column {
      display: none;
    }
  </style>
</head>
<body>
  <%- include('partials/navbar_admin') %>

  <h2>Update Tutor</h2>

  <table>
    <thead>
      <tr>
        <th class="id-column">ID</th> <!-- Hidden -->
        <th>Tutor Name</th>
        <th>Subject</th>
        <th>Email</th>
        <th>Phone</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% tutors.forEach(tutor => { %>
        <tr>
          <form action="/update_tutor/<%= tutor.id %>" method="POST">
            
            <input type="hidden" name="id" value="<%= tutor.id %>" />

            <td class="id-column"><%= tutor.id %></td> 
            <td><input type="text" name="username" value="<%= tutor.username %>" required /></td>
            <td><input type="text" name="subject" value="<%= tutor.subject %>" required /></td>
            <td><input type="email" name="email" value="<%= tutor.email %>" required /></td>
            <td><input type="text" name="phone" value="<%= tutor.phone %>" required /></td>
            <td><button type="submit">Save</button></td>
          </form>
        </tr>
      <% }) %>

      <!-- Add New Tutor Row -->
      <tr>
        <form action="/add_tutor" method="POST">
          <td class="id-column"><%= nextTutorId %></td> <!-- Hidden -->
          <td>
            <select name="tutor_id" required>
              <% users.forEach(user => { %>
                <option value="<%= user.user_id %>"><%= user.username %></option>
              <% }) %>
            </select>
          </td>
          <td><input type="text" name="subject" required /></td>
          <td><input type="email" name="email" required /></td>
          <td><input type="text" name="phone" required /></td>
          <td><button type="submit">Add</button></td>
        </form>
      </tr>
    </tbody>
  </table>
</body>
</html>
