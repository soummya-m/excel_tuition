<h1>Edit Course</h1>
<form action="/admin/update_course/<%= course.id %>" method="POST">
  <input type="hidden" name="id" value="<%= course.id %>">

  <label>Course Name:</label>
  <input type="text" name="course_name" value="<%= course.course_name %>" required><br>

  <label>Tutor ID:</label>
  <input type="number" name="tutor_id" value="<%= course.tutor_id %>" required><br>

  <label>Course Price:</label>
  <input type="text" name="course_price" value="<%= course.course_price %>" required><br>

  <label>Days:</label>
  <input type="text" name="days" value="<%= course.days %>" required><br>

  <label>Time:</label>
  <input type="text" name="time" value="<%= course.time %>" required><br>

  <button type="submit">Update Course</button>
</form>
