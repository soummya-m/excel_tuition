<!DOCTYPE html>
<html lang="en">
<head>
 <%- include('partials/header1') %>
</head>
<%- include('partials/navbar_tutor.ejs') %>
<head>
  <meta charset="UTF-8" />
  <title>My Students</title>
  <style>
    table {
      width: 80%;
      margin: 20px auto;
      border-collapse: collapse;
    }
    th, td {
      border: 1px solid #333;
      padding: 10px;
      text-align: left;
    }
    th {
      background-color: #3e6677;
      color: white;
    }
    tr:nth-child(even) {
      background-color: #f2f2f2;
    }
    h2 {
      text-align: center;
      margin-top: 30px;
    }
  </style>
</head>
<body>
  <h2>My Students</h2>
  <table>
    <thead>
      <tr>
        <th>Student ID</th>
        <th>Username</th>
        <th>Email</th>
         <th>subject</th>
      </tr>
    </thead>
    <tbody>
      <% if (students.length === 0) { %>
        <tr><td colspan="3" style="text-align:center;">No students assigned.</td></tr>
      <% } else { %>
        <% students.forEach(student => { %>
          <tr>
            <td><%= student.user_id %></td>
            <td><%= student.username %></td>
            <td><%= student.email %></td>
            <td><%= student.subject %></td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</body>
</html>
