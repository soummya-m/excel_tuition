<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/header1') %>  <!-- Assuming this includes meta tags, CSS links, etc. -->
  <title>Update Course</title>
  <style>
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 30px;
    }
    th, td {
      border: 1px solid #999;
      padding: 12px;
      text-align: center;
    }
    th {
      background-color: #3e6677;
      color: white;
    }
    tr:nth-child(even) {
      background-color: #f2f2f2;
    }
    h2 {
      text-align: center;
      margin-top: 40px;
    }
  </style>
</head>
<body>
  <%- include('partials/navbar_admin') %>

  <h2>Update Course</h2>

  <table>
    <thead>
      <tr>
        <th>Course ID</th>
        <th>Course Name</th>
        <th>Tutor Name</th>
        <th>Course Price</th>
        <th>Days</th>
        <th>Time</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% courses.forEach(function(course) { %>
        <form action="/update_course/<%= course.course_id %>" method="POST">

       
          <tr>
            <td><%= course.course_id %></td>
            <td>
              <input type="text" name="course_name" value="<%= course.course_name %>" required>
            </td>
            <td>
              <select name="tutor_id" required>
                <% tutors.forEach(function(tutor) { %>
                  <option value="<%= tutor.user_id %>" <%= tutor.user_id === course.tutor_id ? 'selected' : '' %> >
                    <%= tutor.username %>
                  </option>
                <% }) %>
              </select>
            </td>
            <td>
              <input type="text" name="course_price" value="<%= course.course_price %>" required>
            </td>
            <td>
              <input type="text" name="days" value="<%= course.days %>" required>
            </td>
            <td>
              <input type="text" name="time" value="<%= course.time %>" required>
            </td>
            <td>
              <button type="submit">Save</button>
            </td>
          </tr>
        </form>
      <% }) %>

      <!-- Add new course row -->
      <form action="/update_course/add" method="POST">
        <tr>
          <td><%= nextCourseId %></td>
          <input type="hidden" name="course_id" value="<%= nextCourseId %>">
          <td><input type="text" name="course_name" required></td>
          <td>
            <select name="tutor_id" required>
              <% tutors.forEach(function(tutor) { %>
                <option value="<%= tutor.user_id %>"><%= tutor.username %></option>
              <% }) %>
            </select>
          </td>
          <td><input type="text" name="course_price" required></td>
          <td><input type="text" name="days" required></td>
          <td><input type="text" name="time" required></td>
          <td><button type="submit">Add</button></td>
        </tr>
      </form>
    </tbody>
  </table>
</body>
</html>
